<?xml version="1.0" encoding="utf-8"?>
<!-- Zair Auto, 2026-10-15. GPL-3.0. Cover background: shows the focused (D-pad / rotary)
     and the currently playing item, which a transparent background used to hide. -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="?attr/rippleColor">
    <item android:id="@android:id/mask">
        <shape android:shape="rectangle">
            <solid android:color="#FFFFFFFF" />
            <corners android:radius="10dp" />
        </shape>
    </item>
    <item android:id="@android:id/background">
        <selector>
            <item android:state_focused="true">
                <shape android:shape="rectangle">
                    <solid android:color="#296BADE1" />
                    <stroke android:width="2dp" android:color="#FFA6D0F1" />
                    <corners android:radius="10dp" />
                </shape>
            </item>
            <item android:state_activated="true">
                <shape android:shape="rectangle">
                    <solid android:color="#336BADE1" />
                    <stroke android:width="1dp" android:color="#996BADE1" />
                    <corners android:radius="10dp" />
                </shape>
            </item>
            <item android:state_selected="true">
                <shape android:shape="rectangle">
                    <solid android:color="#336BADE1" />
                    <corners android:radius="10dp" />
                </shape>
            </item>
            <item>
                <color android:color="@android:color/transparent" />
            </item>
        </selector>
    </item>
</ripple>
